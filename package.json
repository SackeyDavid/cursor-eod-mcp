{
  "name": "@techhalo/cursor-eod-mcp",
  "version": "1.0.12",
  "description": "MCP server for automatically summarizing daily work in Cursor AI and posting EOD status updates to Slack",
  "main": "dist/index.js",
  "bin": {
    "cursor-eod-mcp": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
